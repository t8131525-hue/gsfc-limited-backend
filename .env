# # -----------------------------------
# # 🗄️ PostgreSQL Database Configuration
# # -----------------------------------

# # Name of your PostgreSQL database.
# # Example: myprojectdb
# POSTGRES_DB=new
# # POSTGRES_DB=gsfcltd-test

# # Username used to connect to the PostgreSQL database.
# # Example: postgres
# POSTGRES_USER=postgres

# # Password for the above PostgreSQL user.
# # Keep this secret and never commit it to version control.
# POSTGRES_PASSWORD=root

# # Host where your PostgreSQL server is running.
# # Use 'localhost' if running locally, or the service name if using Docker (e.g. 'db').
# # Example: localhost OR db
# POSTGRES_HOST=localhost

# # Port number on which PostgreSQL is accessible.
# # Default PostgreSQL port is 5432.
# POSTGRES_PORT=5432


# # -----------------------------------
# # 🕒 Localization
# # -----------------------------------
# # Your app’s timezone (default: Asia/Kolkata)
# TIME_ZONE=Asia/Kolkata


# # -----------------------------------
# # 🔑 JWT Token Settings
# # -----------------------------------
# # Access token lifetime (in minutes)
# ACCESS_TOKEN_LIFETIME=60

# # Refresh token lifetime (in days)
# REFRESH_TOKEN_LIFETIME=1


# # -----------------------------------
# # 🌐 CORS (Frontend Access)
# # -----------------------------------
# # Comma-separated list of frontend URLs allowed to access your backend API.
# # Example: http://localhost:3000,https://staging.yourdomain.com,https://yourdomain.com
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.29.101:3000

# # Allow sending cookies/credentials with cross-origin requests (True/False)
# CORS_ALLOW_CREDENTIALS=True

# # Headers exposed to the browser
# CORS_EXPOSE_HEADERS=Content-Disposition
# -----------------------------------
# 🔐 Django Security
# -----------------------------------

SECRET_KEY=YOUR_DJANGO_SECRET_KEY

DEBUG=False

ALLOWED_HOSTS=localhost,127.0.0.1,192.168.29.101


